<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:consumeSystemWindowsInsets="start|end"
        app:edgeToEdge="true"
        app:fitsSystemWindowsInsets="start|end"
        tools:ignore="RtlHardcoded">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/main_nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/main" />

        <FrameLayout
            android:id="@+id/main_toolbar_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingStart="@dimen/l1"
            android:paddingTop="@dimen/l_50"
            android:paddingEnd="@dimen/l1"
            app:fitsSystemWindowsInsets="top">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/main_toolbar_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/main_toolbar"
                    style="@style/widget_foundation_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    tools:title="Home" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/main_navigation"
            style="@style/Widget.Material3.BottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"
            app:elevation="8dp"
            app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
            app:itemIconTint="?attr/colorOnSurfaceVariant"
            app:itemTextColor="?attr/colorOnSurfaceVariant"
            app:labelVisibilityMode="selected"
            app:fitsSystemWindowsInsets="start|end|bottom"
            app:menu="@menu/menu_bottom_nav" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/main_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/l1"
            android:layout_marginBottom="84dp"
            android:contentDescription="@string/scroll_to_top"
            android:visibility="gone"
            android:src="@drawable/ic_scroll_top"
            app:backgroundTint="?colorPrimary"
            app:elevation="8dp"
            app:tint="?colorOnPrimary" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>
